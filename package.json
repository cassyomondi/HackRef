{
  "name": "hackref",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.0 <23",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.4",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node --conditions=react-server --import tsx --test tests/unit/*.test.ts",
    "test:db": "node --conditions=react-server --import tsx --test tests/database/*.test.ts",
    "test:http": "node --conditions=react-server --import tsx --test tests/http/*.test.ts",
    "check": "npm run test && npm run typecheck && npm run lint",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "auth:configure": "node --import tsx scripts/configure-auth.ts",
    "organizer:setup": "node --import tsx scripts/setup-organizer.ts",
    "db:seed": "node --import tsx scripts/seed.ts",
    "db:test:setup": "node --import tsx scripts/setup-test-database.ts",
    "worker": "node --conditions=react-server --import tsx scripts/worker.ts",
    "gemini:contract": "node --conditions=react-server --import tsx scripts/gemini-contract.ts"
  },
  "dependencies": {
    "@google/genai": "2.32.0",
    "@next/env": "16.4.4",
    "drizzle-orm": "0.45.4",
    "iron-session": "9.0.1",
    "next": "16.4.4",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
