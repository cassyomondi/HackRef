# Sandbox credentials only. Never commit .env or share these values in chat.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Existing sandbox personal account email, not a real recipient.
PAYPAL_SANDBOX_RECIPIENT_EMAIL=
# USD only; restricted to $0.01–$5.00. Balance must cover fees too.
PAYPAL_PAYOUT_AMOUNT_USD=1.00
# Choose once per intended payout. Never rotate IDs to recover a timeout.
PAYPAL_SENDER_BATCH_ID=
PAYPAL_SENDER_ITEM_ID=
# Optional read-only lookup IDs; execute ignores these.
PAYPAL_PAYOUT_BATCH_ID=
PAYPAL_PAYOUT_ITEM_ID=
