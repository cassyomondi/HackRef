# Local development only. Copy to .env; never commit credentials.
# These sample values are NOT production credentials.
POSTGRES_USER=hackref
POSTGRES_PASSWORD=hackref_local_only
POSTGRES_DB=hackref
POSTGRES_PORT=5433
DATABASE_URL=postgresql://hackref:hackref_local_only@127.0.0.1:5433/hackref
# Optional: use a separate local test database, never a production database.
# TEST_DATABASE_URL=postgresql://hackref:hackref_local_only@127.0.0.1:5433/hackref_test
# Run npm run auth:configure to add these to your ignored .env without printing a secret.
# SESSION_PASSWORD=generate_at_least_32_random_bytes_never_reuse_this_comment
# Exact browser origin. Development HTTP must be loopback. Production MUST use HTTPS.
# APP_ORIGIN=http://localhost:3000
# Optional server-only GitHub REST authentication, shared by the app and worker.
# Set your own token in ignored .env or your server environment; never NEXT_PUBLIC_.
# Public repositories only; grant only read access needed for public metadata/commits.
# GITHUB_API_TOKEN=
# AI draft evaluations: worker-only Gemini credentials; never use NEXT_PUBLIC_.
# Configure a model available to your API account. No silent model fallback.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Historical PASS 2 jobs do not require Gemini. No PayPal credentials are used.
