# Local development only. Copy to .env; never commit credentials.
# These sample values are NOT production credentials.
POSTGRES_USER=hackref
POSTGRES_PASSWORD=hackref_local_only
POSTGRES_DB=hackref
POSTGRES_PORT=5433
DATABASE_URL=postgresql://hackref:hackref_local_only@127.0.0.1:5433/hackref
# Optional: use a separate local test database, never a production database.
# TEST_DATABASE_URL=postgresql://hackref:hackref_local_only@127.0.0.1:5433/hackref_test
# No PayPal, Gemini, AG Studio or authentication secrets in PASS 1.
